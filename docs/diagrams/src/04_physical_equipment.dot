digraph G {
  graph [rankdir=TB, splines=true, nodesep=0.45, ranksep=0.9, fontname="Liberation Sans", pad=0.2, newrank=true];
  node [shape=plain, fontname="Liberation Sans", fontsize=11];
  edge [dir=both, color="#404040", penwidth=1.2, arrowsize=1.0];
  locations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="4" BGCOLOR="#E2EFDA" ALIGN="CENTER"><B>locations</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">ID</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(100)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN UQ</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">location_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">location_kind</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">address</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(255)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  equipment_type [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="4" BGCOLOR="#E2EFDA" ALIGN="CENTER"><B>equipment_type</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">SMALLINT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">ID</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(100)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN UQ</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">category</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">equipment_category</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">vendor</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(50)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">snmp_mib</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(100)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">snmp_profile</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(50)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  metric [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="4" BGCOLOR="#FFF2CC" ALIGN="CENTER"><B>metric</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">SMALLINT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">ID</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(50)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN UQ</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(100)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">unit</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  equipment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="4" BGCOLOR="#E2EFDA" ALIGN="CENTER"><B>equipment</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">ID</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>type_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">SMALLINT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>location_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(100)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN UQ</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">model</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(100)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">serial_number</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(50)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">ip_address</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INET</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN UQ</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>credential_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">SMALLINT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>config_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INTEGER</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">snmp_port</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">poll_interval_s</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">SMALLINT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">equipment_status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">failed_polls</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">SMALLINT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">last_seen_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BOOLEAN</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">installed_on</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATE</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR></TABLE>>];
  ups_details [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="4" BGCOLOR="#E2EFDA" ALIGN="CENTER"><B>ups_details</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK,FK</FONT></TD><TD ALIGN="LEFT"><U>equipment_id</U></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INTEGER</FONT></TD><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">rated_power_va</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">rated_power_w</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INTEGER</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">battery_capacity_ah</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NUMERIC(6,1)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">battery_count</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">SMALLINT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">nominal_voltage_v</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NUMERIC(5,1)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">battery_installed_on</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DATE</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  threshold [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="4" BGCOLOR="#FFF2CC" ALIGN="CENTER"><B>threshold</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">ID</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>equipment_type_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">SMALLINT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>metric_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">SMALLINT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">severity</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">severity_level</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">min_value</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NUMERIC(12,3)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">max_value</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NUMERIC(12,3)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BOOLEAN</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR></TABLE>>];
  metric_reading [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="4" BGCOLOR="#FFF2CC" ALIGN="CENTER"><B>metric_reading  «partitioned»</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK,FK</FONT></TD><TD ALIGN="LEFT"><U>equipment_id</U></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INTEGER</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK,FK</FONT></TD><TD ALIGN="LEFT"><U>metric_id</U></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">SMALLINT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>read_at</U></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">value</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DOUBLE PRECISION</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR></TABLE>>];
  locations -> equipment [arrowtail=teetee, arrowhead=crowodot, style=solid];
  equipment_type -> equipment [arrowtail=teetee, arrowhead=crowodot, style=solid];
  equipment -> ups_details [arrowtail=teetee, arrowhead=teeodot, style=solid];
  metric -> threshold [arrowtail=teetee, arrowhead=crowodot, style=solid];
  equipment_type -> threshold [arrowtail=teetee, arrowhead=crowodot, style=solid];
  equipment -> metric_reading [arrowtail=teetee, arrowhead=crowodot, style=solid];
  metric -> metric_reading [arrowtail=teetee, arrowhead=crowodot, style=solid];
}