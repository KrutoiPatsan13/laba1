digraph G {
  graph [rankdir=TB, splines=true, nodesep=0.45, ranksep=0.9, fontname="Liberation Sans", pad=0.2, newrank=true];
  node [shape=plain, fontname="Liberation Sans", fontsize=11];
  edge [dir=both, color="#404040", penwidth=1.2, arrowsize=1.0];
  roles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="4" BGCOLOR="#DCE6F2" ALIGN="CENTER"><B>roles</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">SMALLINT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">ID</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN UQ</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(50)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN UQ</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="4" BGCOLOR="#DCE6F2" ALIGN="CENTER"><B>users</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">ID</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>role_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">SMALLINT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(150)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">login</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(50)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN UQ</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(100)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(254)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">telegram_chat_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">UQ</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BOOLEAN</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">last_login_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  incident [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="4" BGCOLOR="#FBE5D6" ALIGN="CENTER"><B>incident</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">ID</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>equipment_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">incident_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">incident_kind</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>threshold_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INTEGER</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">metric_value</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">DOUBLE PRECISION</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">incident_status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">opened_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">escalated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">acknowledged_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>acknowledged_by</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INTEGER</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">resolved_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">closed_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">close_comment</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  notification [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="4" BGCOLOR="#FBE5D6" ALIGN="CENTER"><B>notification</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">ID</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>incident_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>user_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">channel</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">notify_channel</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">notify_status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">is_escalation</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BOOLEAN</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">sent_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">error_message</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">TEXT</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  event_log [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="4" BGCOLOR="#FBE5D6" ALIGN="CENTER"><B>event_log</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BIGINT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">ID</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">event_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">event_kind</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>user_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INTEGER</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>equipment_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INTEGER</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>incident_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BIGINT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">message</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(500)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">details</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">JSONB</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  equipment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F" STYLE="dashed"><TR><TD BGCOLOR="#E2EFDA"><B>equipment</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><U>id</U> <FONT POINT-SIZE="9">(див. рис. 4)</FONT></TD></TR></TABLE>>];
  threshold [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F" STYLE="dashed"><TR><TD BGCOLOR="#FFF2CC"><B>threshold</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><U>id</U> <FONT POINT-SIZE="9">(див. рис. 4)</FONT></TD></TR></TABLE>>];
  roles -> users [arrowtail=teetee, arrowhead=crowodot, style=solid];
  users -> incident [arrowtail=teeodot, arrowhead=crowodot, style=dashed];
  equipment -> incident [arrowtail=teetee, arrowhead=crowodot, style=solid];
  threshold -> incident [arrowtail=teeodot, arrowhead=crowodot, style=dashed];
  incident -> notification [arrowtail=teetee, arrowhead=crowodot, style=solid];
  users -> notification [arrowtail=teetee, arrowhead=crowodot, style=solid];
  equipment -> event_log [arrowtail=teeodot, arrowhead=crowodot, style=dashed];
  incident -> event_log [arrowtail=teeodot, arrowhead=crowodot, style=dashed];
  users -> event_log [arrowtail=teeodot, arrowhead=crowodot, style=dashed];
}