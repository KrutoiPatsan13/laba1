digraph G {
  graph [rankdir=TB, splines=true, nodesep=0.45, ranksep=0.9, fontname="Liberation Sans", pad=0.2, newrank=true];
  node [shape=plain, fontname="Liberation Sans", fontsize=11];
  edge [dir=both, color="#404040", penwidth=1.2, arrowsize=1.0];
  snmp_config [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="4" BGCOLOR="#E4DFEC" ALIGN="CENTER"><B>snmp_config</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">ID</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">file_path</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(255)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">sha256</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">CHAR(64)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN UQ</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">format_version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">SMALLINT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">content</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">JSONB</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">loaded_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">TIMESTAMPTZ</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>loaded_by</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INTEGER</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">BOOLEAN</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR></TABLE>>];
  snmp_credential [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="4" BGCOLOR="#E4DFEC" ALIGN="CENTER"><B>snmp_credential</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">SMALLINT</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">ID</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>config_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(50)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN UQ</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">snmp_version</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">snmp_version</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(64)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">auth_protocol</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">snmp_auth_proto</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">priv_protocol</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">snmp_priv_proto</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">secret_ref</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(100)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR></TABLE>>];
  snmp_oid_map [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="4" BGCOLOR="#E4DFEC" ALIGN="CENTER"><B>snmp_oid_map</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK,FK</FONT></TD><TD ALIGN="LEFT"><U>equipment_type_id</U></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">SMALLINT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK,FK</FONT></TD><TD ALIGN="LEFT"><U>metric_id</U></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">SMALLINT</FONT></TD><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">oid</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">VARCHAR(128)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">scale</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">NUMERIC(12,6)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>config_id</I></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NN</FONT></TD></TR></TABLE>>];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F" STYLE="dashed"><TR><TD BGCOLOR="#DCE6F2"><B>users</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><U>id</U> <FONT POINT-SIZE="9">(див. рис. 6)</FONT></TD></TR></TABLE>>];
  equipment_type [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F" STYLE="dashed"><TR><TD BGCOLOR="#E2EFDA"><B>equipment_type</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><U>id</U> <FONT POINT-SIZE="9">(див. рис. 4)</FONT></TD></TR></TABLE>>];
  metric [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F" STYLE="dashed"><TR><TD BGCOLOR="#FFF2CC"><B>metric</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><U>id</U> <FONT POINT-SIZE="9">(див. рис. 4)</FONT></TD></TR></TABLE>>];
  equipment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" COLOR="#7F7F7F" STYLE="dashed"><TR><TD BGCOLOR="#E2EFDA"><B>equipment</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><U>id</U> <FONT POINT-SIZE="9">(див. рис. 4)</FONT></TD></TR></TABLE>>];
  users -> snmp_config [arrowtail=teeodot, arrowhead=crowodot, style=dashed];
  snmp_config -> snmp_credential [arrowtail=teetee, arrowhead=crowodot, style=solid];
  snmp_config -> snmp_oid_map [arrowtail=teetee, arrowhead=crowodot, style=solid];
  metric -> snmp_oid_map [arrowtail=teetee, arrowhead=crowodot, style=solid];
  equipment_type -> snmp_oid_map [arrowtail=teetee, arrowhead=crowodot, style=solid];
  snmp_config -> equipment [arrowtail=teeodot, arrowhead=crowodot, style=dashed];
  snmp_credential -> equipment [arrowtail=teetee, arrowhead=crowodot, style=solid];
}