digraph G {
  graph [rankdir=TB, splines=true, nodesep=0.45, ranksep=0.9, fontname="Liberation Sans", pad=0.2, newrank=true];
  node [shape=plain, fontname="Liberation Sans", fontsize=11];
  edge [dir=both, color="#404040", penwidth=1.2, arrowsize=1.0];
  roles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="2" BGCOLOR="#DCE6F2" ALIGN="CENTER"><B>roles</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">code</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">description <FONT POINT-SIZE="9">(O)</FONT></TD></TR></TABLE>>];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="2" BGCOLOR="#DCE6F2" ALIGN="CENTER"><B>users</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>role_id</I></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">full_name</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">login</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">password_hash</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">email <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">telegram_chat_id <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">is_active</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">created_at</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">last_login_at <FONT POINT-SIZE="9">(O)</FONT></TD></TR></TABLE>>];
  locations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="2" BGCOLOR="#E2EFDA" ALIGN="CENTER"><B>locations</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">location_type</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">address</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">description <FONT POINT-SIZE="9">(O)</FONT></TD></TR></TABLE>>];
  equipment_type [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="2" BGCOLOR="#E2EFDA" ALIGN="CENTER"><B>equipment_type</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">category</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">vendor <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">snmp_mib <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">snmp_profile <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">description <FONT POINT-SIZE="9">(O)</FONT></TD></TR></TABLE>>];
  metric [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="2" BGCOLOR="#FFF2CC" ALIGN="CENTER"><B>metric</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">code</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">unit <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">description <FONT POINT-SIZE="9">(O)</FONT></TD></TR></TABLE>>];
  snmp_config [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="2" BGCOLOR="#E4DFEC" ALIGN="CENTER"><B>snmp_config</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">file_path</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">sha256</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">format_version</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">content</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">loaded_at</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>loaded_by</I> <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">is_active</TD></TR></TABLE>>];
  snmp_credential [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="2" BGCOLOR="#E4DFEC" ALIGN="CENTER"><B>snmp_credential</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>config_id</I></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">snmp_version</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">username <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">auth_protocol <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">priv_protocol <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">secret_ref</TD></TR></TABLE>>];
  snmp_oid_map [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="2" BGCOLOR="#E4DFEC" ALIGN="CENTER"><B>snmp_oid_map</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK,FK</FONT></TD><TD ALIGN="LEFT"><U>equipment_type_id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK,FK</FONT></TD><TD ALIGN="LEFT"><U>metric_id</U></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">oid</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">scale</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>config_id</I></TD></TR></TABLE>>];
  equipment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="2" BGCOLOR="#E2EFDA" ALIGN="CENTER"><B>equipment</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>type_id</I></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>location_id</I></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">model <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">serial_number <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">ip_address</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>credential_id</I></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>config_id</I> <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">snmp_port</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">poll_interval_s</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">failed_polls</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">last_seen_at <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">is_active</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">installed_on <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">created_at</TD></TR></TABLE>>];
  ups_details [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="2" BGCOLOR="#E2EFDA" ALIGN="CENTER"><B>ups_details</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK,FK</FONT></TD><TD ALIGN="LEFT"><U>equipment_id</U></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">rated_power_va</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">rated_power_w <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">battery_capacity_ah</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">battery_count</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">nominal_voltage_v <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">battery_installed_on <FONT POINT-SIZE="9">(O)</FONT></TD></TR></TABLE>>];
  threshold [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="2" BGCOLOR="#FFF2CC" ALIGN="CENTER"><B>threshold</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>equipment_type_id</I></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>metric_id</I></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">severity</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">min_value <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">max_value <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">is_active</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">updated_at</TD></TR></TABLE>>];
  metric_reading [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="2" BGCOLOR="#FFF2CC" ALIGN="CENTER"><B>metric_reading</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK,FK</FONT></TD><TD ALIGN="LEFT"><U>equipment_id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK,FK</FONT></TD><TD ALIGN="LEFT"><U>metric_id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>read_at</U></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">value</TD></TR></TABLE>>];
  incident [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="2" BGCOLOR="#FBE5D6" ALIGN="CENTER"><B>incident</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>equipment_id</I></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">incident_type</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>threshold_id</I> <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">metric_value <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">opened_at</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">escalated_at <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">acknowledged_at <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>acknowledged_by</I> <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">resolved_at <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">closed_at <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">close_comment <FONT POINT-SIZE="9">(O)</FONT></TD></TR></TABLE>>];
  notification [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="2" BGCOLOR="#FBE5D6" ALIGN="CENTER"><B>notification</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>incident_id</I></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>user_id</I></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">channel</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">is_escalation</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">created_at</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">sent_at <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">error_message <FONT POINT-SIZE="9">(O)</FONT></TD></TR></TABLE>>];
  event_log [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#404040"><TR><TD COLSPAN="2" BGCOLOR="#FBE5D6" ALIGN="CENTER"><B>event_log</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">created_at</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">event_type</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>user_id</I> <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>equipment_id</I> <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT"><I>incident_id</I> <FONT POINT-SIZE="9">(O)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">message</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">details <FONT POINT-SIZE="9">(O)</FONT></TD></TR></TABLE>>];
  roles -> users [arrowtail=teetee, arrowhead=crowodot, style=solid];
  users -> snmp_config [arrowtail=teeodot, arrowhead=crowodot, style=dashed];
  snmp_config -> snmp_credential [arrowtail=teetee, arrowhead=crowodot, style=solid];
  snmp_config -> snmp_oid_map [arrowtail=teetee, arrowhead=crowodot, style=solid];
  metric -> snmp_oid_map [arrowtail=teetee, arrowhead=crowodot, style=solid];
  equipment_type -> snmp_oid_map [arrowtail=teetee, arrowhead=crowodot, style=solid];
  snmp_config -> equipment [arrowtail=teeodot, arrowhead=crowodot, style=dashed];
  snmp_credential -> equipment [arrowtail=teetee, arrowhead=crowodot, style=solid];
  locations -> equipment [arrowtail=teetee, arrowhead=crowodot, style=solid];
  equipment_type -> equipment [arrowtail=teetee, arrowhead=crowodot, style=solid];
  equipment -> ups_details [arrowtail=teetee, arrowhead=teeodot, style=solid];
  metric -> threshold [arrowtail=teetee, arrowhead=crowodot, style=solid];
  equipment_type -> threshold [arrowtail=teetee, arrowhead=crowodot, style=solid];
  equipment -> metric_reading [arrowtail=teetee, arrowhead=crowodot, style=solid];
  metric -> metric_reading [arrowtail=teetee, arrowhead=crowodot, style=solid];
  users -> incident [arrowtail=teeodot, arrowhead=crowodot, style=dashed];
  equipment -> incident [arrowtail=teetee, arrowhead=crowodot, style=solid];
  threshold -> incident [arrowtail=teeodot, arrowhead=crowodot, style=dashed];
  incident -> notification [arrowtail=teetee, arrowhead=crowodot, style=solid];
  users -> notification [arrowtail=teetee, arrowhead=crowodot, style=solid];
  equipment -> event_log [arrowtail=teeodot, arrowhead=crowodot, style=dashed];
  incident -> event_log [arrowtail=teeodot, arrowhead=crowodot, style=dashed];
  users -> event_log [arrowtail=teeodot, arrowhead=crowodot, style=dashed];
  { rank=same; roles; locations; equipment_type; metric; snmp_config; }
  { rank=same; users; snmp_credential; equipment; threshold; snmp_oid_map; }
  { rank=same; ups_details; metric_reading; incident; }
  { rank=same; notification; event_log; }
}