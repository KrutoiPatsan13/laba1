# NetGuard Monitor — змінні для docker compose (docker-compose.yml).
#   cp .env.example .env
# Порожні обов'язкові змінні (POSTGRES_PASSWORD, NETGUARD_JWT_SECRET, NETGUARD_STORAGE_SECRET)
# потрібно заповнити — без них compose не запуститься. Випадкове значення:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# .env містить секрети — не додавайте його до git.

# --- PostgreSQL: пароль власника схеми netguard (сервіс db і всі сервіси з доступом до БД)
POSTGRES_PASSWORD=

# --- API Gateway і Reporting Service: спільний секрет підпису токенів JWT; строк дії токена, хв
NETGUARD_JWT_SECRET=
NETGUARD_JWT_TTL_MIN=480

# --- Web UI: секрет підпису сесій
NETGUARD_STORAGE_SECRET=

# --- Polling Service
# YAML-конфігурація SNMP — файл з каталогу config/ (для демо-даних — snmp_config.demo.yaml)
NETGUARD_SNMP_CONFIG_FILE=snmp_config.yaml
# секрети SNMP, на які посилається YAML: ${SNMP_UPS_V3_SECRET} (SNMPv3 ДБЖ),
# ${SNMP_NET_COMMUNITY} (community SNMPv2c комутаторів і маршрутизаторів)
SNMP_UPS_V3_SECRET=
SNMP_NET_COMMUNITY=
# несправності емулятора SNMP-агентів, напр. SW-LUK-02=offline;UPS-TER-01=battery_low
NETGUARD_SIM_FAULTS=

# --- Alerting Service: ескалація інцидентів, не прийнятих за стільки хвилин
NETGUARD_ESCALATE_AFTER_MIN=5

# --- Notification Service: 1 — e-mail і Telegram не надсилаються, а пишуться в outbox.log
NETGUARD_NOTIFY_DRY_RUN=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=netguard@localhost
TELEGRAM_BOT_TOKEN=
